APP_NAME=OmniGrab
ENVIRONMENT=production
DEBUG=false

# JSON array of allowed origins, e.g. ["https://your-domain.com"]
ALLOWED_ORIGINS=["*"]

MAX_CONCURRENT_DOWNLOADS=4
TASK_TTL_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=300
MAX_VIDEO_DURATION_SECONDS=10800
RATE_LIMIT=20/minute

# Optional: path to a cookies.txt for platforms that need a login to view
# public-but-gated content. Never commit real cookies to source control.
COOKIES_FILE=

SOCKET_TIMEOUT=20
